# ProcureMind AI — Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# ── Future AI API Integration ────────────────────────────────────────────────
# Set these when connecting the AI model/API built by your team.
# Usage in code: import.meta.env.VITE_AI_API_ENDPOINT
VITE_AI_API_ENDPOINT=https://your-model-endpoint.com/api
VITE_AI_API_KEY=your-secret-api-key-here

# ── Optional: AI model variant ───────────────────────────────────────────────
VITE_AI_MODEL_NAME=procuremind-v1

# ── App Configuration ────────────────────────────────────────────────────────
VITE_APP_ENV=development
