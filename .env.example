# ProcureMind AI — Environment Configuration Example
# Copy this file to .env and configure your real model API endpoint when ready.
# Do NOT commit your actual .env file or real API keys to version control.

# External/Local AI Model Endpoint (supports OpenAI/Anthropic/Gemini or Custom proxy format)
# Example: https://api.openai.com/v1/chat/completions or https://your-custom-ai-service.com/v1/procurement/reason
VITE_AI_API_ENDPOINT=

# Authentication Key / Bearer Token for the AI Model Endpoint
VITE_AI_API_KEY=
